local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local CoreGui = game:GetService("CoreGui")

_G.MzherTranslationActive = true
_G.Language = "中文"

local function ForceTranslateToChinese(text)
    if type(text) ~= "string" or text == "" or text:match("^[%d%p%s]+$") then
        return text
    end

    if text:match("[\228-\233][\128-\191][\128-\191]") then
        return text
    end

    local success, result = pcall(function()
        local url = "https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=zh-CN&dt=t&q=" .. HttpService:UrlEncode(text)
        local response = game:HttpGet(url)
        local data = HttpService:JSONDecode(response)
        if data and data[1] and data[1][1] and data[1][1][1] then
            return data[1][1][1]
        end
    end)

    if success and result then
        return result
    end
    return text
end

local function HookAndTranslateObject(obj)
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        task.spawn(function()
            local original = obj.Text
            if original and original ~= "" then
                local translated = ForceTranslateToChinese(original)
                if translated and translated ~= original then
                    obj.Text = translated
                end
            end
        end)

        if not obj:GetAttribute("IsHookedByMzher") then
            obj:SetAttribute("IsHookedByMzher", true)
            obj:GetPropertyChangedSignal("Text"):Connect(function()
                local currentText = obj.Text
                if currentText and currentText ~= "" then
                    task.spawn(function()
                        local newTranslated = ForceTranslateToChinese(currentText)
                        if newTranslated and newTranslated ~= currentText then
                            obj.Text = newTranslated
                        end
                    end)
                end
            end)
        end
    end
end

local function StartGlobalInterceptor(rootContainer)
    for _, descendant in ipairs(rootContainer:GetDescendants()) do
        HookAndTranslateObject(descendant)
    end

    rootContainer.DescendantAdded:Connect(function(descendant)
        task.wait(0.1)
        HookAndTranslateObject(descendant)
    end)
end

task.spawn(function()
    pcall(function() StartGlobalInterceptor(LocalPlayer:WaitForChild("PlayerGui")) end)
    pcall(function() StartGlobalInterceptor(CoreGui) end)
end)

game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "mzher Hub 翻譯引擎",
    Text = "全域強制中文化已就緒！",
    Duration = 4
})
