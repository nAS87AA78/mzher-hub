    end

    local okLocations, locationsResult = pcall(function()
        return WorldTeleporterRF:InvokeServer({ Type = "GetLocations" })
    end)

    if not okLocations or type(locationsResult) ~= "table" or locationsResult.WasSuccess ~= true then
        Runtime.Status = "World Teleporter not ready; retrying from Middle Town"
        pcall(HiddenRelease)
        return
    end

    local availableKey = nil
    for _, key in ipairs(locationsResult.Locations or {}) do
        if tostring(key) == tostring(target.Key) then
            availableKey = key
            break
        end
    end

    if not availableKey then
        Runtime.Status = "Story destination unavailable: " .. tostring(target.Name) .. " (" .. tostring(target.Key) .. ")"
        return
    end

    CombatV2State.LastStoryTeleport = tick()
    pcall(HiddenRelease)

    local okTeleport, teleportResult = pcall(function()
        return WorldTeleporterRF:InvokeServer({
            Type = "TeleportTo",
            IslandKey = availableKey,
        })
    end)

    if okTeleport and type(teleportResult) == "table" and teleportResult.WasSuccess == true then
        CombatV2State.StoryIndex = index + 1
        Runtime.LastMeaningfulProgress = tick()
        Runtime.Status = "World Teleporter accepted " .. tostring(target.Name)
        task.wait(1.2)
        CombatV2State.LastPhaseCheck = 0
        return
    end

    local err = type(teleportResult) == "table" and teleportResult.ErrMessage or teleportResult
    Runtime.Status = "Story teleport rejected: " .. tostring(err or target.Name)
end

