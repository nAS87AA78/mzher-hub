local MOVE_PROXY_NAME = "YELU0_OptimizedTweenPart"
local MoveState = {
    Tween = nil,
    Goal = nil,
    Proxy = nil,
    Active = false,
    Hold = false,
    HoldCFrame = nil,
    HoldWasAnchored = nil,
    Token = 0,
    Root = nil,
}

local function getCharacter()
    local c = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local hrp = c:WaitForChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid") or c:WaitForChild("Humanoid")
    return c, hrp, hum
end

local function getTweenProxy()
    local p = workspace:FindFirstChild(MOVE_PROXY_NAME)
    if p and p:IsA("BasePart") then
        MoveState.Proxy = p
        return p
    end
    p = Instance.new("Part")
    p.Name = MOVE_PROXY_NAME
    p.Size = Vector3.one
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Massless = true
    p.Transparency = 1
    p.Parent = workspace
    MoveState.Proxy = p
    return p
end

local function addFloatForce(hrp)
    if not hrp then return end
    local force = hrp:FindFirstChild("FloatForce")
    if not force then
        force = Instance.new("BodyVelocity")
        force.Name = "FloatForce"
        force.Velocity = Vector3.zero
        force.MaxForce = Vector3.new(100000,100000,100000)
        force.P = 10000
        force.Parent = hrp
    else
        force.Velocity = Vector3.zero
        force.MaxForce = Vector3.new(100000,100000,100000)
    end
end

local function removeFloatForce()
    local c = localPlayer.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if hrp then
        local force = hrp:FindFirstChild("FloatForce")
        if force then pcall(function() force:Destroy() end) end
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

local function setCharacterNoclip(character)
    if not character then return end
    for _,p in ipairs(character:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
        end
    end
end

local function stopMove(keepForce)
    MoveState.Token += 1

    local tw = MoveState.Tween
    local holdRoot = MoveState.Root
    local wasHolding = MoveState.Hold
    local previousAnchored = MoveState.HoldWasAnchored

    if wasHolding and holdRoot and holdRoot.Parent then
        pcall(function()
            holdRoot.Anchored = previousAnchored == true
            holdRoot.AssemblyLinearVelocity = Vector3.zero
            holdRoot.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    MoveState.Tween = nil
    Runtime.CurrentTween = nil
    Runtime.TweenGoal = nil
    MoveState.Active = false
    MoveState.Hold = false
    MoveState.HoldCFrame = nil
    MoveState.HoldWasAnchored = nil
    MoveState.Root = nil

    if tw then
        pcall(function()
            tw:Cancel()
            tw:Destroy()
        end)
    end

    if not keepForce then
        removeFloatForce()
    end
end

local function cancelTween()
    stopMove(false)
end

TweenManager.CancelTweenOnly = cancelTween
TweenManager.CancelCurrent = cancelTween
StopTweenNow = cancelTween

local function beginPositionHold(cf)
    stopMove(true)
    local c, hrp, hum = getCharacter()
    if not hrp or not hum or hum.Health <= 0 then
        removeFloatForce()
        return false
    end

    MoveState.Token += 1
    MoveState.Active = true
    MoveState.Hold = true
    MoveState.HoldCFrame = cf or hrp.CFrame
    MoveState.HoldWasAnchored = hrp.Anchored
    MoveState.Root = hrp

    -- Hard local lock for the short Portal-C UI window. BodyVelocity alone was
    setCharacterNoclip(c)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = MoveState.HoldCFrame
    hrp.Anchored = true
    return true
end

local function releasePositionHold()
    if MoveState.Hold then
        stopMove(false)
    end
end

RunService.Stepped:Connect(function()
    if not MoveState.Active then
        if IsKaitunOwnerActive() then
            local c = localPlayer.Character
            if c then setCharacterNoclip(c) end
        end
        return
    end

    local c = localPlayer.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 or (MoveState.Root and MoveState.Root ~= hrp) then
        stopMove(false)
        return
    end

    setCharacterNoclip(c)

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    if MoveState.Hold and MoveState.HoldCFrame then
        if not hrp.Anchored then hrp.Anchored = true end
        hrp.CFrame = MoveState.HoldCFrame
    elseif MoveState.Proxy and MoveState.Proxy.Parent then
        addFloatForce(hrp)
        hrp.CFrame = MoveState.Proxy.CFrame
    end
end)

