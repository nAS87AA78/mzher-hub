			local active = GetHiddenMoment(v8.Name)

			local lockedPriority = HiddenEvent.taskLock == v8.Name
			local flag3 = v8.Name == "Rescue Hasan" and active

			if lockedPriority then
				tbl10[v8] = -10
				HiddenEvent.skipped[v8.Name] = nil
			elseif flag3 then
