local function HasMatchingActiveAwakenedBoss(quest)
    if not quest or not quest.BossNames then return false end

    for _, enemy in ipairs(workspace.Enemies:GetChildren()) do
        if enemy:GetAttribute("BossIndicatorAwakened") and IsHiddenTarget(enemy) then
            for _, bossName in ipairs(quest.BossNames) do
                if string.find(enemy.Name, bossName, 1, true) then
                    return true
