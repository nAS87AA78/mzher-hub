HopHiddenServer = function(reason)
    if Runtime.HopInProgress then
        return true
    end

    Runtime.HopInProgress = true
    Runtime.Status = reason or "Server hopping"

    cancelTween()
    pcall(HiddenRelease)
    HiddenEvent.fighting = nil
    HiddenEvent.arrived = nil
    HiddenEvent.islandArrived = nil
    HiddenEvent.waitingSince = nil
    Runtime.TweenGoal = nil

    QueueHiddenReload()

    HiddenEvent.hopped = HiddenEvent.hopped or {}
    _G.JumpHistory = _G.JumpHistory or {}

    local startJobId = game.JobId

    local function SeenServer(id)
        return HiddenEvent.hopped[id] or table.find(_G.JumpHistory, id) ~= nil
    end

    local function RememberServer(id)
        HiddenEvent.hopped[id] = true
        table.insert(_G.JumpHistory, id)
        if #_G.JumpHistory > 100 then
            table.remove(_G.JumpHistory, 1)
        end
    end

    local function GetPublicServers(cursor)
        local url =
            "https://games.roblox.com/v1/games/"
            .. tostring(game.PlaceId)
            .. "/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100"

        if cursor and cursor ~= "" then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local ok, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if ok and type(result) == "table" and type(result.data) == "table" then
            return result
        end
        return nil
    end

    local function FindPublicServer(data)
        if type(data) ~= "table" then return nil end

        -- Secret Kaitun does not care about PvP population. Any DIFFERENT,
        for _, server in ipairs(data) do
            if type(server) == "table" and server.id then
                local id = tostring(server.id)
                local playing = tonumber(server.playing) or 0
                local maxPlayers = tonumber(server.maxPlayers) or 12

                if id ~= tostring(startJobId)
                    and not SeenServer(id)
                    and playing < maxPlayers
                then
                    return id
                end
            end
        end

        return nil
    end

    local function PickNextPublicServer()
        local page = GetPublicServers()
        if not page then
            return nil
        end

        local id = FindPublicServer(page.data)
        if id then return id end

        local cursor = page.nextPageCursor
        for _ = 1, 3 do
            if not cursor then break end
            page = GetPublicServers(cursor)
            if not page then break end

            id = FindPublicServer(page.data)
            if id then return id end
            cursor = page.nextPageCursor
        end

        return nil
    end

    task.spawn(function()
        local attempts = 0

        while Runtime.HopInProgress and game.JobId == startJobId and attempts < 8 do
            attempts += 1

            local targetId = PickNextPublicServer()

            if not targetId then
                HiddenEvent.hopped = {}
                _G.JumpHistory = {}
                targetId = PickNextPublicServer()
            end

            if not targetId then
                Runtime.Status = "Hop: no public server found; retrying"
                task.wait(1.5)
                continue
            end

            RememberServer(targetId)
            Runtime.Status = ("Hop public server %d/8"):format(attempts)
            print("[YELU0 KAITUN] public hop ->", targetId, reason or "")

            local sent = pcall(function()
                local serverBrowser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
                if serverBrowser then
                    serverBrowser:InvokeServer("teleport", targetId)
                else
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, targetId, localPlayer)
                end
            end)

            if not sent then
                Runtime.Status = "Hop request failed; trying another public server"
            end

            -- AutoBounty-style confirmation: if JobId did not change quickly,
            local deadline = os.clock() + 4
            while Runtime.HopInProgress
                and game.JobId == startJobId
                and os.clock() < deadline
            do
                task.wait(0.1)
            end

            if game.JobId ~= startJobId then
                Runtime.HopInProgress = false
                return
            end

            Runtime.Status = "Hop did not leave server; trying next public server"
            task.wait(0.75)
        end

        if game.JobId == startJobId then
            Runtime.HopInProgress = false
            Runtime.Status = "Server hop failed after public-server retries"
        end
    end)

    return true
end

