local function getPortalTool()
    local character = localPlayer.Character
    return (character and character:FindFirstChild("Portal-Portal"))
        or localPlayer.Backpack:FindFirstChild("Portal-Portal")
end

local function isPortalFruitReady()
    local data = localPlayer:FindFirstChild("Data")
    local devilFruit = data and data:FindFirstChild("DevilFruit")
    if not devilFruit or devilFruit.Value ~= "Portal-Portal" then
        return false
    end

    local tool = getPortalTool()
    if not tool then return false end

    local level = tool:FindFirstChild("Level")
    if level and tonumber(level.Value) and tonumber(level.Value) <= 200 then
        return false
    end

    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid and tool.Parent ~= character then
        pcall(function() humanoid:EquipTool(tool) end)
        return false
    end

    local main = localPlayer.PlayerGui:FindFirstChild("Main")
    local skills = main and main:FindFirstChild("Skills")
    local fruitSkills = skills and skills:FindFirstChild("Portal-Portal")
    local cSkill = fruitSkills and fruitSkills:FindFirstChild("C")
    if not cSkill or not cSkill:IsA("Frame") then return false end

    local title = cSkill:FindFirstChild("Title")
    local cooldown = cSkill:FindFirstChild("Cooldown")
    if not title or not title:IsA("TextLabel") then return false end
    if title.TextColor3 ~= Color3.new(1,1,1) then return false end

    if cooldown and cooldown:IsA("GuiObject") then
        local sz = cooldown.Size
        if sz ~= UDim2.new(0,0,1,-1) and sz ~= UDim2.new(1,0,1,-1) then
            return false
        end
    end
    return true
end

local function activatePortalGateway(destination)
    local tool = getPortalTool()
    local character = localPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not tool or not humanoid or not hrp then return false end

    -- water / falling while the Gateway UI is opening and selecting an island.
    beginPositionHold(hrp.CFrame)

    if tool.Parent ~= character then
        pcall(function() humanoid:EquipTool(tool) end)
        task.wait(0.15)
    end

    local main = localPlayer.PlayerGui:FindFirstChild("Main")
    local gateway = main and main:FindFirstChild("Gateway")
    if not gateway then
        releasePositionHold()
        return false
    end

    pcall(function()
        VirtualInputManager:SendKeyEvent(true,"C",false,game)
        task.wait(0.03)
        VirtualInputManager:SendKeyEvent(false,"C",false,game)
    end)

    local deadline = tick()+3
    while not gateway.Visible and tick()<deadline do
        task.wait(0.05)
    end
    if not gateway.Visible then
        releasePositionHold()
        return false
    end

    local mainContent = gateway:FindFirstChild("MainContent")
    local scrolling = mainContent and mainContent:FindFirstChild("ScrollingFrame")
    local button = scrolling and scrolling:FindFirstChild(tostring(destination))
    if not button or not button:IsA("GuiButton") then
        releasePositionHold()
        return false
    end

    local fired = false
    if type(getconnections)=="function" then
        for _,connection in pairs(getconnections(button.MouseButton1Click)) do
            if connection.Function then
                local ok = pcall(connection.Function)
                fired = fired or ok
            end
        end
    end
    if not fired and type(firesignal)=="function" then
        fired = pcall(firesignal,button.MouseButton1Click)
    end

    if not fired then
        releasePositionHold()
        return false
    end

    Runtime.Status = "Portal C locked - waiting for teleport"
    local waitStart = tick()
    local sawTeleporting = false

    while tick() - waitStart < 2.25 do
        if localPlayer:HasTag("Teleporting") then
            sawTeleporting = true
            break
        end

        local currentCharacter = localPlayer.Character
        local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
        if not currentRoot or currentRoot ~= MoveState.Root then
            break
        end

        task.wait(0.03)
    end

    releasePositionHold()

    if sawTeleporting then
        Runtime.Status = "Portal C teleporting"
    else
        Runtime.Status = "Portal C selection sent"
    end

    return true
end

local function portalFruitTravel(goal,distance)
    if not Settings["Use Portal Fruit Teleport"] or distance<3000 then return false end
    if tick()<(Runtime.PortalRetryAfter or 0) then return false end
    if not isPortalFruitReady() then return false end

    local bestName,bestPoint,bestDistance
    for name,point in pairs(PORTAL_SEA1_POINTS) do
        local d=(goal.Position-point).Magnitude
        if d<=3000 and (not bestDistance or d<bestDistance) then
            bestName,bestPoint,bestDistance=name,point,d
        end
    end
    if not bestName then return false end

    cancelTween()
    Runtime.Status="Portal C → "..bestName
    local ok=activatePortalGateway(bestName)
    if not ok then
        Runtime.PortalRetryAfter=tick()+3
        return false
    end

    local deadline=tick()+5
    while tick()<deadline do
        task.wait(0.15)
        local c=localPlayer.Character
        local hrp=c and c:FindFirstChild("HumanoidRootPart")
        if hrp and (hrp.Position-bestPoint).Magnitude<500 then
            hrp.AssemblyLinearVelocity=Vector3.zero
            hrp.AssemblyAngularVelocity=Vector3.zero
            Runtime.Status="Portal arrived: "..bestName
            return true
        end
    end

    Runtime.PortalRetryAfter=tick()+4
    Runtime.Status="Portal timeout; fallback Tween"
    return false
end

local function startProxyTween(goal,speed)
    local c,hrp,hum=getCharacter()
    if not hrp or not hum or hum.Health<=0 then return false end

    local dist=(hrp.Position-goal.Position).Magnitude
    if dist<=5 then
        stopMove(true)
        hrp.CFrame=goal
        hrp.AssemblyLinearVelocity=Vector3.zero
        hrp.AssemblyAngularVelocity=Vector3.zero
        removeFloatForce()
        return true
    end

    if MoveState.Active and not MoveState.Hold and MoveState.Goal and MoveState.Tween
        and (MoveState.Goal.Position-goal.Position).Magnitude<3 then
        return true
    end

    stopMove(true)
    local proxy=getTweenProxy()
    proxy.CFrame=hrp.CFrame

    local token=MoveState.Token+1
    MoveState.Token=token
    MoveState.Active=true
    MoveState.Hold=false
    MoveState.HoldCFrame=nil
    MoveState.Goal=goal
    MoveState.Root=hrp

    addFloatForce(hrp)
    setCharacterNoclip(c)

    local actualSpeed=tonumber(speed) or tonumber(Settings["Tween Speed"]) or 180
    actualSpeed=math.clamp(actualSpeed,30,220)
    local duration=math.max(dist/actualSpeed,0.05)
    local tw=TweenService:Create(proxy,TweenInfo.new(duration,Enum.EasingStyle.Linear,Enum.EasingDirection.Out),{CFrame=goal})
    MoveState.Tween=tw
    Runtime.CurrentTween=tw
    Runtime.TweenGoal=goal
    tbl3.LastCall=tick()

    tw.Completed:Connect(function(playback)
        if MoveState.Token~=token or MoveState.Tween~=tw then return end
        local cc=localPlayer.Character
        local root=cc and cc:FindFirstChild("HumanoidRootPart")
        if root and playback==Enum.PlaybackState.Completed then
            root.CFrame=goal
            root.AssemblyLinearVelocity=Vector3.zero
            root.AssemblyAngularVelocity=Vector3.zero
        end
        MoveState.Tween=nil
        Runtime.CurrentTween=nil
        Runtime.TweenGoal=nil
        MoveState.Active=false
        MoveState.Goal=nil
        MoveState.Root=nil
        removeFloatForce()
        pcall(function() tw:Destroy() end)
    end)

    tw:Play()
    return true
end

ToTarget=function(goal,speed)
    if typeof(goal)~="CFrame" then return false end
    if Runtime.HopInProgress then return false end
    if tick()<(TweenManager.PauseUntil or 0) then return false end
    local c,hrp,hum=getCharacter()
    if hum.Health<=0 then return false end

    if hum.Sit then
        hum.Sit=false
        task.wait()
    end

    local rawDist=(hrp.Position-goal.Position).Magnitude
    if portalFruitTravel(goal,rawDist) then
        return true
    end

    local hereUnder=hrp.Position.X>30000
    local goalUnder=goal.Position.X>30000
    if goalUnder and not hereUnder then
        local stand=Vector3.new(4050,6,-1815)
        if (hrp.Position-stand).Magnitude<=12 then
            cancelTween()
            pcall(function()
                CommF:InvokeServer("requestEntrance",Vector3.new(61163.85,11.6796875,1819.7842))
            end)
            task.wait(1)
            return true
        end
        goal=CFrame.new(stand)
    elseif hereUnder and not goalUnder then
        local stand=Vector3.new(61170,1,1952)
        if (hrp.Position-stand).Magnitude<=12 then
            cancelTween()
            pcall(function()
                CommF:InvokeServer("requestEntrance",Vector3.new(3864.6885,6.74402,-1926.2141))
            end)
            task.wait(1)
            return true
        end
        goal=CFrame.new(stand)
    end

    Runtime.Status="Stable tween "..math.floor((hrp.Position-goal.Position).Magnitude).." studs"
    return startProxyTween(goal,speed)
end

