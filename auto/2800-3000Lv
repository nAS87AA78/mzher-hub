    if Runtime.LastNeededBossHoldLog ~= logKey then
        Runtime.LastNeededBossHoldLog = logKey
        print(
            "[YELU0/Hidden][Awakened] NEEDED HOLD -> "
            .. boss .. "@" .. tostring(hint.Island)
            .. " State=" .. state
            .. " T=" .. seconds .. "s"
            .. " -> " .. quest.Name
            .. " | STAY SERVER / NO HOP"
        )
    end

    if HiddenGoToIsland(quest.Island) then
        local island = GetHiddenIsland(quest.Island)
