	-- Idle-only Safe Zone support.
	GetHiddenSafeZoneRadius = function(part)
		if not part or not part:IsA("BasePart") then
			return nil
		end

		local mesh = part:FindFirstChildWhichIsA("SpecialMesh")
		if not mesh or mesh.MeshType ~= Enum.MeshType.Sphere then
			return nil
		end

		local worldScale = Vector3.new(
			part.Size.X * mesh.Scale.X,
			part.Size.Y * mesh.Scale.Y,
			part.Size.Z * mesh.Scale.Z
		)

		return math.max(worldScale.X, worldScale.Y, worldScale.Z) * 0.5
	end

	IsHiddenInSafeZone = function()
		local ok, global = pcall(require, ReplicatedStorage.Global)
		return ok and type(global) == "table" and global.InSafeZone == true
	end

	FindHiddenIdleSafeSpot = function(parkPosition)
		local worldOrigin = workspace:FindFirstChild("_WorldOrigin")
		local folder = worldOrigin and worldOrigin:FindFirstChild("SafeZones")
		if not folder or typeof(parkPosition) ~= "Vector3" then
			return nil
		end

		HiddenEvent.safeZoneRejected = HiddenEvent.safeZoneRejected or {}

		local bestPart = nil
		local bestRadius = nil
		local bestSurfaceDistance = nil

		for _, part in ipairs(folder:GetChildren()) do
			if part:IsA("BasePart") then
				local rejectedUntil = HiddenEvent.safeZoneRejected[part]
				if not rejectedUntil or rejectedUntil <= tick() then
					local radius = GetHiddenSafeZoneRadius(part)

					if radius and radius >= 8 then
						local centerDistance = (part.Position - parkPosition).Magnitude
						local surfaceDistance = math.max(0, centerDistance - radius)

						if surfaceDistance <= 550
							and (not bestSurfaceDistance or surfaceDistance < bestSurfaceDistance)
						then
							bestPart = part
							bestRadius = radius
							bestSurfaceDistance = surfaceDistance
						end
					end
				end
			end
		end

		if not bestPart then
			return nil
		end

		-- keep it. Otherwise use the SafeZone's X/Z center while preserving the
		local margin = math.max(6, math.min(20, bestRadius * 0.08))
		local delta = parkPosition - bestPart.Position
		local safeSpot

		if delta.Magnitude <= bestRadius - margin then
			safeSpot = parkPosition
		else
			local y = parkPosition.Y
			safeSpot = Vector3.new(bestPart.Position.X, y, bestPart.Position.Z)

			if (safeSpot - bestPart.Position).Magnitude > bestRadius - margin then
				safeSpot = bestPart.Position + Vector3.new(0, math.min(6, bestRadius * 0.1), 0)
			end
		end

		return safeSpot, bestPart, bestRadius
	end

	ParkHiddenIdleSafely = function(normalParkPosition)
		local safeSpot, safePart, safeRadius = FindHiddenIdleSafeSpot(normalParkPosition)

		if not safeSpot then
			HiddenEvent.safePark = nil
			HiddenEvent.safeParkArrived = nil
			if HiddenGoTo(normalParkPosition, 60) then
				HiddenHold(CFrame.new(normalParkPosition))
			end
			return false
		end

		local safeKey = safePart:GetFullName() .. "|" .. tostring(safePart.Position)
		local previous = HiddenEvent.safePark

		if not previous or previous.key ~= safeKey or (previous.position - safeSpot).Magnitude > 3 then
			HiddenEvent.safePark = {
				key = safeKey,
				part = safePart,
				position = safeSpot,
				radius = safeRadius,
			}
			HiddenEvent.safeParkArrived = nil
		end

		if not HiddenGoTo(safeSpot, 8) then
			return true
		end

		HiddenHold(CFrame.new(safeSpot))
		HiddenEvent.safeParkArrived = HiddenEvent.safeParkArrived or tick()

		if IsHiddenInSafeZone() then
			HiddenEvent.safeParkVerified = safeKey
			HiddenEvent.safeParkFailedLog = nil
			return true
		end

		-- Give the game's own zone controller a moment to update Global.InSafeZone.
		if tick() - HiddenEvent.safeParkArrived < 1.5 then
			return true
		end

		HiddenEvent.safeZoneRejected[safePart] = tick() + 120
		HiddenEvent.safePark = nil
		HiddenEvent.safeParkArrived = nil

		local failKey = safePart:GetFullName() .. "|" .. tostring(safePart.Position)
		if HiddenEvent.safeParkFailedLog ~= failKey then
			HiddenEvent.safeParkFailedLog = failKey
			print(
				"[YELU0/Hidden][SafeZone] candidate rejected by Global.InSafeZone | "
				.. tostring(safePart.Position)
			)
		end

		if HiddenGoTo(normalParkPosition, 60) then
			HiddenHold(CFrame.new(normalParkPosition))
		end

		return false
	end

