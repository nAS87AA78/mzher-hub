local FPSBoostHook
local FPSGlobalOriginal

local function rememberFPSObject(obj)
    local old = Runtime.FPSOriginal[obj]
    if old ~= nil then return old end
    old = {}
    Runtime.FPSOriginal[obj] = old

    pcall(function()
        if obj:IsA("ParticleEmitter") then
            old.kind = "ParticleEmitter"; old.Enabled = obj.Enabled; old.Lifetime = obj.Lifetime
        elseif obj:IsA("Trail") then
            old.kind = "Trail"; old.Enabled = obj.Enabled; old.Lifetime = obj.Lifetime
        elseif obj:IsA("Beam") then
            old.kind = "Beam"; old.Enabled = obj.Enabled
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            old.kind = "Texture"; old.Transparency = obj.Transparency
        elseif obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("SpotLight") then
            old.kind = "Enabled"; old.Enabled = obj.Enabled
        elseif obj:IsA("BasePart") then
            old.kind = "Part"; old.Material = obj.Material; old.Reflectance = obj.Reflectance
        elseif obj:IsA("BlurEffect") then
            old.kind = "Blur"; old.Enabled = obj.Enabled
        end
    end)

    return old
end

local function applyFPSObject(obj, on)
    local old = rememberFPSObject(obj)
    if not old or not old.kind then return end

    pcall(function()
        if on then
            if old.kind == "ParticleEmitter" then
                if not (obj.Parent and obj.Parent.Name == "ElectricFire") then
                    obj.Enabled = false
                    obj.Lifetime = NumberRange.new(0)
                end
            elseif old.kind == "Trail" then
                obj.Enabled = false
                obj.Lifetime = NumberRange.new(0)
            elseif old.kind == "Beam" or old.kind == "Enabled" or old.kind == "Blur" then
                obj.Enabled = false
            elseif old.kind == "Texture" then
                obj.Transparency = 1
            elseif old.kind == "Part" then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
            end
        else
            if old.kind == "ParticleEmitter" then
                obj.Enabled = old.Enabled
                obj.Lifetime = old.Lifetime
            elseif old.kind == "Trail" then
                obj.Enabled = old.Enabled
                obj.Lifetime = old.Lifetime
            elseif old.kind == "Beam" or old.kind == "Enabled" or old.kind == "Blur" then
                obj.Enabled = old.Enabled
            elseif old.kind == "Texture" then
                obj.Transparency = old.Transparency
            elseif old.kind == "Part" then
                obj.Material = old.Material
                obj.Reflectance = old.Reflectance
            end
        end
    end)
end

local function applyFPSBoost(on)
    Settings["FPS Boost"] = on

    if not FPSGlobalOriginal then
        FPSGlobalOriginal = {}
        pcall(function()
            FPSGlobalOriginal.GlobalShadows = Lighting.GlobalShadows
            FPSGlobalOriginal.QualityLevel = settings().Rendering.QualityLevel
            local terrain = workspace.Terrain
            FPSGlobalOriginal.WaterWaveSize = terrain.WaterWaveSize
            FPSGlobalOriginal.WaterWaveSpeed = terrain.WaterWaveSpeed
            FPSGlobalOriginal.WaterReflectance = terrain.WaterReflectance
            FPSGlobalOriginal.WaterTransparency = terrain.WaterTransparency
        end)
    end

    pcall(function()
        if on then
            Lighting.GlobalShadows = false
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            local terrain = workspace.Terrain
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 0
        else
            Lighting.GlobalShadows = FPSGlobalOriginal.GlobalShadows
            settings().Rendering.QualityLevel = FPSGlobalOriginal.QualityLevel
            local terrain = workspace.Terrain
            terrain.WaterWaveSize = FPSGlobalOriginal.WaterWaveSize
            terrain.WaterWaveSpeed = FPSGlobalOriginal.WaterWaveSpeed
            terrain.WaterReflectance = FPSGlobalOriginal.WaterReflectance
            terrain.WaterTransparency = FPSGlobalOriginal.WaterTransparency
        end
    end)

    local slice = os.clock()
    for _, obj in ipairs(game:GetDescendants()) do
        applyFPSObject(obj, on)
        if os.clock() - slice > 0.004 then
            task.wait()
            slice = os.clock()
        end
    end

    pcall(function()
        local optimizer = localPlayer.PlayerScripts:FindFirstChild("OptimizerClientActor")
        if optimizer and optimizer.SendMessage then
            optimizer:SendMessage("Optimize", on == true)
        end
    end)

    if not FPSBoostHook then
        FPSBoostHook = game.DescendantAdded:Connect(function(obj)
            if Settings["FPS Boost"] then
                task.defer(function() applyFPSObject(obj, true) end)
            end
        end)
    end
end

