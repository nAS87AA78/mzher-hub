		local chefMissing = HiddenEvent.chefMissing

		if chefMissing then
			local gatherStep = GatherChefIngredients()

			if gatherStep and tick() - (chefMissing.time or 0) < 20 then
				return gatherStep
			end

			HiddenEvent.chefMissing = nil
			HiddenEvent.cooked = 0
		end

		local cauldronMoment = workspace.Map.Pirate:FindFirstChild("Cauldron_Moment")
		local cauldron = cauldronMoment and (
			cauldronMoment:FindFirstChild("Cauldron")
			or cauldronMoment:FindFirstChildWhichIsA("BasePart", true)
		)

		if not cauldron then
			return "Waiting for the Chef's cauldron"
		end

		if tick() - (HiddenEvent.cooked or 0) <= 8 then
			return "Waiting for the Chef's cauldron"
		end

		if not HiddenSettle(cauldron:GetPivot().Position + Vector3.new(0, 3, 6), 10) then
			return "Go to the tavern cauldron"
		end

		HiddenEvent.cooked = tick()
		local response = arg:InvokeServer("OpenCauldron")

		if type(response) ~= "table" then
			return "Waiting for the cauldron to open"
		end

		local recipe = type(response.Recipe) == "table" and response.Recipe or {}
		local placedList = type(response.Placed) == "table" and response.Placed or {}
		local owned = type(response.Owned) == "table" and response.Owned or {}

		if response.Cooked == true then
			arg:FireServer("CloseCauldron")
			return "Chef's recipe is cooked; waiting for the Chef"
		end

		if #recipe == 0 then
			arg:FireServer("CloseCauldron")
			return "Waiting for the Chef's recipe", true
		end

		local function buildPlaced(state)
			local placed = {}
			for _, material in ipairs(type(state.Placed) == "table" and state.Placed or {}) do
				placed[tostring(material)] = true
			end
			return placed
		end

		local missing = {}

		for _, materialValue in ipairs(recipe) do
			local material = tostring(materialValue)
			local placed = buildPlaced(response)

			if not placed[material] then
				owned = type(response.Owned) == "table" and response.Owned or owned
				local amount = tonumber(owned[material]) or 0

				if amount > 0 then
					local inserted = arg:InvokeServer("Insert", material)

					if type(inserted) == "table" then
						response = inserted
						HiddenEvent.chefMissing = nil
					else
						table.insert(missing, material)
					end
				else
					table.insert(missing, material)
				end
			end
		end

		if #missing > 0 then
			arg:FireServer("CloseCauldron")
			HiddenEvent.chefMissing = {
				time = tick(),
				text = "Chef's Kiss needs: " .. table.concat(missing, ", "),
				needs = missing,
			}

			HiddenNotify(HiddenEvent.chefMissing.text, "chefmissing", "warning")
			return GatherChefIngredients() or HiddenEvent.chefMissing.text, true
		end

		-- the official UI rule: only Cook once all Recipe entries are in the pot.
		local placed = buildPlaced(response)
		for _, materialValue in ipairs(recipe) do
			if not placed[tostring(materialValue)] then
				arg:FireServer("CloseCauldron")
				return "Waiting for Chef ingredients to register"
			end
		end

		local cookResult = arg:InvokeServer("Cook")
		arg:FireServer("CloseCauldron")
		HiddenEvent.awakened = HiddenEvent.awakened or {}

		if cookResult == "Cooked" then
			HiddenEvent.awakened["Chef's Kiss"] = tick()
			HiddenEvent.chefMissing = nil
			HiddenNotify("Chef's Kiss: recipe cooked, the Chef is awakening", "chefcooked", "success")
			return "Cook the Chef's recipe"
		end

		if cookResult == "NoChef" then
			return "Recipe is ready; waiting for the Chef", true
		end

		return "Chef cook request returned " .. tostring(cookResult), true
	end

