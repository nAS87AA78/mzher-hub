-- two-stage controller: Secret/Finale first, optional Combat V2 second
local BaseAutoHiddenEvent=AutoHiddenEvent
AutoHiddenEvent=function()
    local progress=GetHiddenProgress()
    local done=CountSecretDone(progress)

    if IsSecretJourneyComplete(progress) then
        if Settings["Get Combat V2"] then
            return AutoCombatV2()
        end

        Runtime.ControlPhase="SECRET_COMPLETE"
        Runtime.Mode="COMPLETE"
        Runtime.Step="40/40"
        Runtime.Status="Level 3000 reached"
        SaveSettings("Auto Secret Quest",false)
        Runtime.Enabled=false
        cancelTween()
        pcall(HiddenRelease)
        return true
    end

    Runtime.ControlPhase="SECRET"

    if done>=39 then
        Runtime.Mode="SECRET REWARD"
        Runtime.Step="39/39 reward"

        if ClaimHiddenReward() then
            Runtime.Status="39/39 complete; claiming the final Secret reward before Finale"
            return true
        end

        if HasPendingHiddenReward() then
            Runtime.Status="Final Secret reward is still pending; Finale is locked"
            return true
        end

        Runtime.Step="Finale"
        return RunFinale()
    end

    if TryEarlyAccessP0(progress) then return end

    -- If an ordinary Secret is already active, Base scheduler sees taskLock=-10
    -- and finishes it before considering other ordinary Secrets.
    if TryNeededAwakenedHold(progress) then return end

    Runtime.Mode="SECRET"

    -- X Marks has its own atomic stage machine (Tree/Pickup/Map/Dig/Chest/etc).
    -- Do not overwrite that stage with the generic "Task" label every scheduler tick.
    local xmarkOwned = HiddenEvent.current == "X Marks The Spot"
        or HiddenEvent.taskLock == "X Marks The Spot"

    if not xmarkOwned then
        Runtime.Step="Task"
    end

    return BaseAutoHiddenEvent()
end

local function waitingStep(step)
    step=string.lower(tostring(step or ""))
    return step:find("waiting",1,true) or step:find("stirs on",1,true) or step:find("needs time",1,true) or step:find("xx:",1,true) or step:find("saving the",1,true) or step:find("not up",1,true)
end
CheckHiddenStall=function()
    local progress=GetHiddenProgress()
    local done=CountSecretDone(progress)
    local sig=table.concat({tostring(done),tostring(HiddenEvent.current),tostring(HiddenEvent.step),tostring(Runtime.Step)},"|")
    if sig~=Runtime.LastSignature then Runtime.LastSignature=sig; Runtime.LastMeaningfulProgress=tick(); Runtime.LastSoftRecovery=tick(); return end
    if waitingStep(HiddenEvent.step) then Runtime.LastMeaningfulProgress=tick(); Runtime.LastSoftRecovery=tick(); return end
    local idle=tick()-Runtime.LastMeaningfulProgress
    if idle>=60 and tick()-Runtime.LastSoftRecovery>=60 then
        Runtime.LastSoftRecovery=tick(); Runtime.Status="Soft recovery: retry current action"
        HiddenEvent.arrived=nil; HiddenEvent.islandArrived=nil; HiddenEvent.waitingSince=nil; pcall(HiddenRelease); cancelTween()
    end
    if idle>=600 then
        Runtime.LastMeaningfulProgress=tick(); Runtime.Status="Hard stuck 10m: hopping server"
        HopHiddenServer("10 minute hard-stuck recovery")
    end
end

