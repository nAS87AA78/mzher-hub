GetHiddenProgress = function(force)
    local refresh = force or (os.clock() - (HiddenEvent.checked or 0) > 5)
    if refresh then
        HiddenEvent.checked = os.clock()
        local ok, result = pcall(function()
            return ReplicatedStorage.Modules.Net["RF/RequestBonusMomentReplication"]:InvokeServer({Type="GetMomentProgress"})
        end)
        if ok and type(result)=="table" and type(result.Data)=="table" then
            local normalized = {}
            for k,v in pairs(result.Data) do
                if type(v)=="table" then normalized[k] = v.Completed == true else normalized[k] = v == true end
            end
            HiddenEvent.progress = normalized
        end
    end
    return HiddenEvent.progress or {}
end

local function CountSecretDone(progress)
    local n=0
    for _,v in pairs(progress or {}) do if v==true or (type(v)=="table" and v.Completed==true) then n+=1 end end
