            local ok,err=pcall(AutoHiddenEvent)
            if not ok then Runtime.Status="ERROR: "..tostring(err):sub(1,130); warn("[YELU0 KAITUN]",err) end
            if Runtime.ControlPhase~="COMBAT_V2" then
                pcall(CheckHiddenStall)
            end
            local anchored=HiddenEvent.anchored
            if anchored and tick()-(HiddenEvent.holdTime or 0)>0.7 then pcall(HiddenRelease) end
        elseif combatEnabled then
            Runtime.Mode="COMBAT V2 WAIT"
