local function FightCombatV2ActiveBoss()
    local boss = FindAwakenedBoss(nil, nil)
    if not boss then
        return false
    end

    local quest = GetCombatV2QuestForBoss(boss.Name)
    CombatV2State.CurrentBoss = boss.Name
    CombatV2State.CurrentQuest = quest and quest.Name or "Awakened Boss"

    Runtime.Mode = "COMBAT V2 BOSS"
    Runtime.Step = CombatV2State.CurrentBoss
    Runtime.Status = "Defeating " .. tostring(CombatV2State.CurrentBoss)

    local bossName = boss.Name
    WithCombatV2Melee(function()
        KillHiddenEnemy(boss)
    end)

    if not IsHiddenTarget(boss) then
        RecordCombatV2BossKill(bossName)
        return true, true
    end

    return true, false
end

local function RunCombatV2BossUnlocker(quest, hint)
    if not quest then
        return false, true
    end

    CombatV2State.CurrentQuest = quest.Name
    CombatV2State.CurrentBoss = (hint and hint.Boss) or quest.BossNames[1] or "Unknown"

    -- Shared V2 boss movement owner:
    -- HiddenGoToIsland is only the entry step.  Once the requested island has
    -- been reached, the individual quest.Run handler owns movement to wires,
    -- clouds, bells, clams, cannons, etc.  Re-running HiddenGoToIsland every
    -- scheduler tick caused those task targets to fight the island reference
    -- point and produced the visible back-and-forth tweening.
    if CombatV2State.BossIslandReadyQuest ~= quest.Name then
        CombatV2State.BossIslandReadyQuest = nil
        CombatV2State.BossIslandReadyAt = nil

        if not HiddenGoToIsland(quest.Island) then
            Runtime.Status = "Going to " .. tostring(quest.Island)
            return true, false
        end

        CombatV2State.BossIslandReadyQuest = quest.Name
        CombatV2State.BossIslandReadyAt = tick()
        Runtime.LastMeaningfulProgress = tick()
        pcall(HiddenRelease)
    end

    local moment = GetCombatV2MomentProxy(quest, hint)
    local callOk, textStatus, waiting = WithCombatV2Melee(function()
        return quest.Run(moment)
    end)

    if not callOk then
        Runtime.Status = "Boss event error: " .. tostring(textStatus):sub(1, 120)
        return true, true
    end

    Runtime.Status = textStatus and tostring(textStatus) or ("Preparing " .. tostring(CombatV2State.CurrentBoss))
    return true, waiting == true
end

local function AutoCombatV2()
    EnterCombatV2()
    ResetCombatV2Hour()

    local window, minute = GetCombatV2Window()
    CombatV2State.Window = window

    local data = localPlayer:FindFirstChild("Data")
    local level = data and data:FindFirstChild("Level")
    if not level or level.Value < 3000 then
        Runtime.Mode = "COMBAT V2 LOCKED"
        Runtime.Step = "Level 3000"
        Runtime.Status = "Combat V2 requires level 3000"
        return
    end

    local phase = RefreshCombatV2Phase(false)

    if phase == "Locked" or phase == "Unknown" then
        Runtime.Mode = "COMBAT V2 LOCKED"
        Runtime.Step = "Secrets Master"
        Runtime.Status = phase == "Locked"
            and "Combat V2 prerequisite is locked"
            or "Unable to read Combat V2 phase"
        return
    end

    if phase == "Complete" then
        ClaimAdvancedCombat()
        return
    end

    if phase == "Stories" then
        RunCombatV2Stories()
        return
    end

    -- After the story teleports, the Prison remover is the legitimate path
    -- back to original Combat. Do not call SetSecretStyle("Combat") here.
    if not HasOriginalCombat() then
        RunCombatV2Repair()
        return
    end

    -- Repair is the observed post-Stories phase. If the server later names
    -- the boss-restoration phase differently, original Combat is still a
    -- stronger gate than a guessed phase label, so continue boss handling.
    Runtime.Mode = "COMBAT V2 BOSS"
    Runtime.Step = "Fountain restoration"

    -- Combat V2 uses a temporary Melee override inside its own handlers;
    -- the user's Secret farming weapon preference is preserved.

    -- Take a spawned awakened boss at any time.
    local foundBoss, killed = FightCombatV2ActiveBoss()
    if foundBoss then
        if killed and window == "FARM" then
            Runtime.Mode = "COMBAT V2 HOP"
            Runtime.Status = "Boss defeated; hopping for another awakened boss"
            task.wait(0.8)
            HopHiddenServer()
        end
        return
    end

    local hint = GetHiddenRaidHint()
    local quest = GetCombatV2QuestForHint(hint)

    if window == "WAIT" then
        CombatV2State.CurrentQuest = quest and quest.Name or "None"
        CombatV2State.CurrentBoss = hint and hint.Boss or "None"
        CombatV2State.NoBossSince = nil

        Runtime.Mode = "COMBAT V2 WAIT"
        Runtime.Step = "Next boss hour"
        Runtime.Status = "Waiting for XX:50 awakened-boss prep"
        return
    end

    if quest then
        Runtime.Mode = window == "PREP" and "COMBAT V2 PREP" or "COMBAT V2 FARM"
        Runtime.Step = quest.Name

        local _, waiting = RunCombatV2BossUnlocker(quest, hint)
        local spawned = FindAwakenedBoss(nil, quest.BossNames)

        if spawned then
            CombatV2State.NoBossSince = nil
            return
        end

        if window == "PREP" then
            CombatV2State.NoBossSince = nil
            return
        end

        if waiting then
            CombatV2State.NoBossSince = CombatV2State.NoBossSince or tick()
        else
            CombatV2State.NoBossSince = nil
            return
        end
    elseif window == "PREP" then
        CombatV2State.CurrentBoss = "Unknown"
        CombatV2State.CurrentQuest = "None"
        Runtime.Mode = "COMBAT V2 PREP"
        Runtime.Step = "Boss hint"
        Runtime.Status = "Waiting for awakened boss hint"
        return
    else
        CombatV2State.NoBossSince = CombatV2State.NoBossSince or tick()
        Runtime.Mode = "COMBAT V2 FARM"
        Runtime.Status = "No active awakened boss in this server"
    end

    -- The same Kaitun public-server hop is reused here; no second hopping
    if window == "FARM"
        and CombatV2State.NoBossSince
        and tick() - CombatV2State.NoBossSince >= 18
    then
        CombatV2State.NoBossSince = nil
        Runtime.Mode = "COMBAT V2 HOP"
        Runtime.Status = "No awakened boss here; hopping public server"
        HopHiddenServer()
    end
end

