local function loadSettings()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return end
    pcall(function()
        if isfile(SETTINGS_FILE) then
            local t = HttpService:JSONDecode(readfile(SETTINGS_FILE))
            if type(t) == "table" then
                for k,v in pairs(t) do
                    if Settings[k] ~= nil then Settings[k] = v end
                end
            end
        end
    end)
    if Settings["Select Weapon"] ~= "Sword" then Settings["Select Weapon"] = "Melee" end
    if Settings["Select Team"] ~= "Pirates" then Settings["Select Team"] = "Marines" end
    local uiScale = tonumber(Settings["UI Scale"]) or 1
    if uiScale < 0.7 or uiScale > 1 then uiScale = 1 end
    Settings["UI Scale"] = uiScale
end
loadSettings()

local function IsKaitunConfiguredActive()
    return Settings["Auto Secret Quest"] == true
