    if HasMatchingActiveAwakenedBoss(quest) then
        HiddenEvent.neededBossHold = nil
        HiddenEvent.deadHourIdleSince = nil
        return false
    end

    HiddenEvent.neededBossHold = quest.Name
    HiddenEvent.deadHourIdleSince = nil
    HiddenEvent.hopAt = nil
