local function FlattenCombatV2Story(story)
    local lines = {}
    if type(story) == "table" then
        for _, line in ipairs(story) do
            lines[#lines + 1] = tostring(line)
        end
    else
        lines[1] = tostring(story)
    end
    return table.concat(lines, " ")
end

local function ResolveCombatV2Story(story)
    local text = string.lower(FlattenCombatV2Story(story))
    local best, bestScore = nil, 0

    for _, rule in ipairs(CombatV2StoryRules) do
        local score = 0
        for _, needle in ipairs(rule.Needles) do
            if string.find(text, string.lower(needle), 1, true) then
                score += 1
            end
        end
        if score > bestScore then
            best = rule
            bestScore = score
        end
    end

    return best, bestScore, text
end

