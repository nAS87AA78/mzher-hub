local function GetCombatV2QuestForBoss(name)
    if not name then return nil end
    for _, quest in ipairs(CombatV2BossQuests) do
        for _, bossName in ipairs(quest.BossNames or {}) do
            if string.find(tostring(name), tostring(bossName), 1, true) then
                return quest
            end
        end
    end
end

local function GetCombatV2QuestForHint(hint)
    if type(hint) ~= "table" then return nil end
    for _, quest in ipairs(CombatV2BossQuests) do
        if IsHiddenBossHinted(hint, quest.HintIsland or quest.Island, quest.BossNames) then
            return quest
        end
    end
end

local function GetCombatV2MomentProxy(quest, hint)
    local loaded = GetHiddenMoment(quest.Name)
    local triggered = type(hint) == "table"
        and IsHiddenBossHinted(hint, quest.HintIsland or quest.Island, quest.BossNames)
        and (
            hint.State == "Triggered"
            or (tonumber(hint.Seconds) or math.huge) <= 0
        )

    if loaded and (loaded.Active or not triggered) then
        return loaded
    end

    local proxy = CombatV2State.Proxies[quest.Name]
    if not proxy then
        proxy = {
            Active = false,
            Progress = 0,
            Completed = false,
            MiscData = {},
        }

        function proxy:FireServer(...)
            return CombatV2MomentRE:FireServer(quest.Name, ...)
        end

        function proxy:InvokeServer(...)
            return CombatV2MomentRF:InvokeServer(quest.Name, ...)
        end

        CombatV2State.Proxies[quest.Name] = proxy
    end

    proxy.Active = triggered
    return proxy
end

