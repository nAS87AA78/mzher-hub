local function RunCombatV2Repair()
    Runtime.Mode = "COMBAT V2 REPAIR"
    Runtime.Step = "Recover original Combat"

    if HasOriginalCombat() then
        Runtime.Status = "Original Combat ready"
        return true
    end

    if not HiddenGoToIsland("Prison") then
        Runtime.Status = "Going to Prison to recover original Combat"
        return false
    end

    if tick() - (CombatV2State.LastRepairAction or 0) < 3 then
        Runtime.Status = "Waiting for Prison remover"
        return false
    end
    CombatV2State.LastRepairAction = tick()

    local fruit = GetCombatV2Fruit()
    if fruit ~= "" and fruit ~= "None" then
        local ok, result = pcall(function()
            return CommF:InvokeServer("RemoveFruit", "Beli")
        end)
        Runtime.Status = ok
            and ("Removing fruit before Combat (" .. tostring(result) .. ")")
            or "RemoveFruit request failed"
        return false
    end

    local ok, result = pcall(function()
        return CommF:InvokeServer("RemoveFightingStyle")
    end)

    CombatV2State.LastStyleResult = ok and result or nil
    if ok and (result == 1 or result == 2) then
        Runtime.LastMeaningfulProgress = tick()
        Runtime.Status = result == 2 and "Original Combat already active" or "Original Combat restored"
        task.wait(0.8)
        return true
    end

    if result == 5 then
        Runtime.Status = "Prison remover still sees a fruit equipped"
    else
        Runtime.Status = "Waiting for Prison fighting-style removal (" .. tostring(result) .. ")"
    end
    return false
end

