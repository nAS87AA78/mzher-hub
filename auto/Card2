-- 自動武裝色
local function EnableBuso()
    pcall(function()
        local char = LocalPlayer.Character
        if char and not char:FindFirstChild("HasBuso") then
            local comm = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
            if comm then
                comm:InvokeServer("Buso")
            end
        end
    end)
end

-- 查詢伺服器真實剩餘小怪數（核心修正：讀取 Drip Mama 進度）
local function QueryServerMobProgress()
    if tick() - LastDripCheckTick < 3.5 then return end
    LastDripCheckTick = tick()

    task.spawn(function()
        pcall(function()
            local comm = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
            if comm then
                local res = comm:InvokeServer("CakePrinceFarmer")
                if type(res) == "string" then
                    -- 從 NPC 回傳的文字中抓取數字 (例如: "You have to defeat 15 more enemies...")
                    local num = string.match(res, "(%d+)")
                    if num then
                        ServerMobsRemaining = tonumber(num)
                    elseif string.find(res:lower(), "open") or string.find(res:lower(), "portal") or string.find(res:lower(), "spawn") then
                        ServerMobsRemaining = 0
                    end
                elseif type(res) == "number" then
                    ServerMobsRemaining = res
                end
            end
        end)

        -- 狀態即時切換
        if ServerMobsRemaining <= 0 then
            CurrentStage = "BossFight"
        else
            CurrentStage = "MobFarm"
        end

        if remainingLabel and remainingLabel.Parent then
            remainingLabel.Text = string.format("伺服器剩餘怪數: %d 隻", ServerMobsRemaining)
        end
    end)
end

local function FindTool(toolType, fallbackKeyword)
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")

    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") then
                if item.ToolTip == toolType or (fallbackKeyword and item.Name:lower():find(fallbackKeyword:lower())) then
                    return item
                end
            end
        end
    end

    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item:IsA("Tool") then
                if item.ToolTip == toolType or (fallbackKeyword and item.Name:lower():find(fallbackKeyword:lower())) then
                    return item
                end
            end
        end
    end
    return nil
end

local function SmartEquip(toolType, fallbackKeyword)
    if currentEquippedType == (fallbackKeyword or toolType) and tick() - equipCooldown < 0.2 then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local tool = FindTool(toolType, fallbackKeyword)
    if tool and tool.Parent ~= char then
        pcall(function()
            hum:EquipTool(tool)
            currentEquippedType = fallbackKeyword or toolType
            equipCooldown = tick()
        end)
    elseif tool and tool.Parent == char then
        currentEquippedType = fallbackKeyword or toolType
    end
end

-- 異步無阻塞發送按鍵（解決 task.wait 凍結主線程導致不變身問題）
local function SendKeyNonBlocking(keyCode)
    task.spawn(function()
        pcall(function()
            if VirtualInputManager then
                VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
                task.wait(0.06)
                VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
            end
        end)
    end)
end

local function GetAliveCakeMobs()
    local mobs = {}
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    local source = enemiesFolder and enemiesFolder:GetChildren() or workspace:GetChildren()

    for _, mob in ipairs(source) do
        if mob:IsA("Model") and CakeMobs[mob.Name] then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local root = mob:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                table.insert(mobs, mob)
            end
        end
    end
    return mobs
end

local function GetAliveBoss()
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    local source = enemiesFolder and enemiesFolder:GetChildren() or workspace:GetChildren()

    for _, mob in ipairs(source) do
        if mob:IsA("Model") and BossMobs[mob.Name] then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local root = mob:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                return mob
            end
        end
    end
    return nil
end

local function SelectTarget()
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    if CurrentStage == "BossFight" then
        local boss = GetAliveBoss()
        currentTarget = boss
        if boss and boss:FindFirstChild("HumanoidRootPart") then
            clusterAnchor = boss.HumanoidRootPart.Position
        else
            clusterAnchor = MirrorWorldPosition
        end
        return currentTarget
    end

    if currentTarget and currentTarget.Parent then
        local thum = currentTarget:FindFirstChildOfClass("Humanoid")
        local troot = currentTarget:FindFirstChild("HumanoidRootPart")
        if thum and troot and thum.Health > 0 then
            return currentTarget
        end
    end

    local bestMob = nil
    local minDistance = math.huge
    local allMobs = GetAliveCakeMobs()

    for _, mob in ipairs(allMobs) do
        local mroot = mob:FindFirstChild("HumanoidRootPart")
        if mroot then
            local dist = (mroot.Position - myRoot.Position).Magnitude
            if dist < minDistance then
                minDistance = dist
                bestMob = mob
            end
        end
    end

    currentTarget = bestMob
    if bestMob and bestMob:FindFirstChild("HumanoidRootPart") then
        clusterAnchor = bestMob.HumanoidRootPart.Position
    else
        clusterAnchor = nil
    end

    return currentTarget
end

-- 高效批量聚怪
local function BringSurroundingMobs(anchorPos)
    if not anchorPos or tick() - lastBringTick < 0.2 then return end
    lastBringTick = tick()
    SafeSetSimRadius()

    local mobs = GetAliveCakeMobs()
    for _, mob in ipairs(mobs) do
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart")
        if hum and root then
            local dist = (root.Position - anchorPos).Magnitude
            if dist <= 280 then
                pcall(function()
                    for _, child in ipairs(mob:GetChildren()) do
                        if child:IsA("Tool") then
                            child:Destroy()
                        end
                    end
                    hum.WalkSpeed = 0
                    hum.JumpPower = 0
                    hum.AutoRotate = false
                    hum:ChangeState(Enum.HumanoidStateType.Physics)
                    root.CanCollide = false
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.CFrame = CFrame.new(anchorPos)
                end)
            end
        end
    end
end

-- 超高速打擊引擎（支援單/群體高頻封包判定）
local function UltraFastAttack(targetMob)
    local char = LocalPlayer.Character
    if not char then return end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
    end

    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2))
    end)

    pcall(function()
        local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
        if not net then return end
        local regAtk = net:FindFirstChild("RE/RegisterAttack")
        local regHit = net:FindFirstChild("RE/RegisterHit")

        if regAtk and regHit and targetMob then
            local troot = targetMob:FindFirstChild("HumanoidRootPart")
            local thead = targetMob:FindFirstChild("Head") or troot
            if troot and (troot.Position - myRoot.Position).Magnitude <= 120 then
                -- 快速註冊揮擊
                regAtk:FireServer(0)

                -- 構建打擊名單 (包含主目標與周圍怪)
                local hitList = {{targetMob, thead}}
                if CurrentStage == "MobFarm" then
                    for _, other in ipairs(GetAliveCakeMobs()) do
                        if other ~= targetMob and other:FindFirstChild("Head") then
                            local oroot = other:FindFirstChild("HumanoidRootPart")
                            if oroot and (oroot.Position - myRoot.Position).Magnitude <= 80 then
                                table.insert(hitList, {other, other.Head})
                            end
                        end
                    end
                end
                regHit:FireServer(thead, hitList)
            end
        end
    end)
end

local function CleanFlight()
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
end

local function InitFlight(root)
    CleanFlight()
    bv = Instance.new("BodyVelocity")
    bv.Name = "MzherFastBV"
    bv.MaxForce = Vector3.new(1e8, 1e8, 1e8)
    bv.Velocity = Vector3.zero
    bv.Parent = root

    bg = Instance.new("BodyGyro")
    bg.Name = "MzherFastBG"
    bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
    bg.P = 5e4
    bg.D = 1200
    bg.CFrame = root.CFrame
    bg.Parent = root
end

local function MoveUprightStable(root, targetPos, lookAtPos)
    if not bv or not bv.Parent or not bg or not bg.Parent then
        InitFlight(root)
    end

    local diff = targetPos - root.Position
    local dist = diff.Magnitude

    if dist > 3 then
        bv.Velocity = diff.Unit * FlySpeed
    else
        bv.Velocity = Vector3.zero
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    local flatForward = Vector3.new(lookAtPos.X - root.Position.X, 0, lookAtPos.Z - root.Position.Z)
    if flatForward.Magnitude > 0.2 then
        bg.CFrame = CFrame.lookAt(root.Position, root.Position + flatForward.Unit, Vector3.new(0, 1, 0))
    else
        bg.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit)
    end
end

local function StopFarm()
    FarmEnabled = false
    if farmLoop then farmLoop:Disconnect() farmLoop = nil end
    if noclipLoop then noclipLoop:Disconnect() noclipLoop = nil end
    if attackLoop then attackLoop:Disconnect() attackLoop = nil end
    CleanFlight()

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end

    currentEquippedType = ""
    currentTarget = nil
    clusterAnchor = nil

    if toggleBtn and toggleBtn.Parent then
        toggleBtn.Text = "開始掛機"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    end
    if statusLabel and statusLabel.Parent then
        statusLabel.Text = "狀態: 已待機"
    end
end

local function StartFarm()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    if farmLoop then farmLoop:Disconnect() farmLoop = nil end
    if noclipLoop then noclipLoop:Disconnect() noclipLoop = nil end
    if attackLoop then attackLoop:Disconnect() attackLoop = nil end

    FarmEnabled = true
    currentEquippedType = ""
    InitFlight(root)

    if toggleBtn and toggleBtn.Parent then
        toggleBtn.Text = "停止掛機"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 190, 80)
    end

    -- 全局穿牆維護 (確保能直接穿透鏡像房間的鏡面牆壁)
    noclipLoop = RunService.Stepped:Connect(function()
        if not FarmEnabled then return end
        local c = LocalPlayer.Character
        if c then
            for _, part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then
                h.PlatformStand = false
                h:ChangeState(Enum.HumanoidStateType.Physics)
            end
        end
    end)

    -- 超高速獨立攻擊循環 (間隔壓至 0.05 秒，絕不卡頓主程序)
    attackLoop = RunService.Heartbeat:Connect(function()
        if not FarmEnabled then return end

        if CurrentStage == "MobFarm" then
            -- 階段 1：拳法高速清怪
            SmartEquip("Melee", nil)
            local target = SelectTarget()
            if target and (tick() - lastAttackTick >= 0.05) then
                lastAttackTick = tick()
                UltraFastAttack(target)
            end
        elseif CurrentStage == "BossFight" then
            -- 階段 2：切換猛獁象果實
            SmartEquip("Blox Fruit", "Mammoth")

            -- 每 1.2 秒異步嘗試按 V（怒氣一旦滿了會立刻完成變身）
            if tick() - LastTransformTryTick > 1.2 then
                LastTransformTryTick = tick()
                SendKeyNonBlocking(Enum.KeyCode.V)
            end

            -- 極限攻速猛獁普攻踐踏
            local boss = SelectTarget()
            if boss and (tick() - lastAttackTick >= 0.05) then
                lastAttackTick = tick()
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, boss.HumanoidRootPart.Position)
                UltraFastAttack(boss)
            end
        end
    end)

    -- 位移與進度輪詢主循環
    farmLoop = RunService.RenderStepped:Connect(function(dt)
        if not FarmEnabled then return end
        local c = LocalPlayer.Character
        if not c then return end
        local myRoot = c:FindFirstChild("HumanoidRootPart")
        local myHum = c:FindFirstChildOfClass("Humanoid")
        if not myRoot or not myHum or myHum.Health <= 0 then return end

        EnableBuso()
        QueryServerMobProgress() -- 自動同步 Drip Mama 數據

        if CurrentStage == "MobFarm" then
            local target = SelectTarget()
            if target then
                local mHum = target:FindFirstChildOfClass("Humanoid")
                local mRoot = target:FindFirstChild("HumanoidRootPart")
                if mHum and mRoot and mHum.Health > 0 then
                    local anchor = clusterAnchor or mRoot.Position
                    BringSurroundingMobs(anchor)

                    OrbitAngle = (OrbitAngle + dt * OrbitSpeed) % (math.pi * 2)
                    local offsetX = math.cos(OrbitAngle) * OrbitRadius
                    local offsetZ = math.sin(OrbitAngle) * OrbitRadius
                    local floatY = BaseHoverHeight + (math.sin(tick() * BobbingSpeed) * BobbingAmp)
                    local targetHoverPos = anchor + Vector3.new(offsetX, floatY, offsetZ)

                    if statusLabel then
                        statusLabel.Text = string.format("狀態: 拳法清怪中 [剩餘: %d 隻]", ServerMobsRemaining)
                    end
                    MoveUprightStable(myRoot, targetHoverPos, anchor)
                end
            else
                if statusLabel then
                    statusLabel.Text = string.format("狀態: 巡邏中... [剩餘: %d 隻]", ServerMobsRemaining)
                end
                local pt = CakePatrolPoints[patrolIndex]
                MoveUprightStable(myRoot, pt, pt + Vector3.new(0, 0, 10))
                if (myRoot.Position - pt).Magnitude < 15 then
                    patrolIndex = (patrolIndex % #CakePatrolPoints) + 1
                end
            end
        elseif CurrentStage == "BossFight" then
            -- 階段 2：小怪已打滿，直奔鏡像世界房間
            local boss = GetAliveBoss()
            if boss and boss:FindFirstChild("HumanoidRootPart") then
                local bRoot = boss.HumanoidRootPart
                -- 懸浮在 Boss 上方 6.5 格，猛獁象 M1 完美打擊判定
                local targetHoverPos = bRoot.Position + Vector3.new(0, 6.5, 0)
                if statusLabel then
                    statusLabel.Text = "狀態: 猛獁象已就位，高速 V 踐踏狂扁卡2/王子！"
                end
                MoveUprightStable(myRoot, targetHoverPos, bRoot.Position)
            else
                if statusLabel then
                    statusLabel.Text = "狀態: 滿怪！直衝鏡像房間等待卡2出現..."
                end
                -- 直接飛往鏡像房間深處
                MoveUprightStable(myRoot, MirrorWorldPosition + Vector3.new(0, 10, 0), MirrorWorldPosition)
            end
        end
    end)
end

